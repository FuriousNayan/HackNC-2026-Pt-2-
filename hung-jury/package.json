{
  "name": "hung-jury",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:room": "tsx scripts/check-room.ts",
    "judge": "tsx src/judge/runner.ts",
    "test": "vitest run && npm run test:media",
    "test:media": "node --import tsx --test tests/*.test.ts",
    "eval:live": "tsx src/judge/evaluate.ts",
    "verify:live": "tsx src/judge/verify-live.ts",
    "pregen-demo": "tsx --env-file=.env.local scripts/pregen-demo.ts",
    "test:voice": "tsx --env-file=.env.local scripts/test-voice.ts",
    "verify:media": "tsx --env-file=.env.local scripts/verify-media.ts",
    "verify:combined": "tsx --env-file=.env.local scripts/verify-combined.ts",
    "lint": "eslint",
    "seed": "tsx scripts/seed.ts",
    "db:check": "tsx scripts/dbCheck.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "preflight": "tsx scripts/preflight.ts"
  },
  "dependencies": {
    "@google/genai": "2.28.0",
    "@mediapipe/tasks-vision": "0.10.32",
    "@next/env": "16.4.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "dotenv": "18.0.7",
    "framer-motion": "^11.11.0",
    "livekit-client": "^2.15.4",
    "lucide-react": "^0.575.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}
