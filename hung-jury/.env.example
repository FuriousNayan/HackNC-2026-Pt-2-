# Copy to .env.local. Never commit real values.

# Part 1 UI: true replays recorded trials and fakes the API, so nothing below is needed to see the UI.
NEXT_PUBLIC_USE_MOCKS=true

# Part 3 judge (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# true: scripted judge and cached-only audio (no Gemini, no ElevenLabs). false: live calls.
DEMO_MODE=true

# Part 4 media (server only)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=1wY62afAwzraM6a0Xjoy
ELEVENLABS_MODEL_FAST=eleven_flash_v2_5
ELEVENLABS_MODEL_VERDICT=eleven_multilingual_v2
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=hung-jury-media
# Cloud Vision SafeSearch + face detection for photo uploads, or inject moderateImage.
GOOGLE_VISION_API_KEY=
# Public site origin when deployed behind a proxy, e.g. https://hungjury.example
APP_ORIGIN=

# Part 2 backend (in memory, single process, no database)
# true: offline scripted judge and no voice, so the whole trial runs with no API keys.
USE_STUB_JUDGE=true
# Multiplies every phase timer. 0.05 runs a trial about 20 times faster for demos and tests.
HJ_TIMER_SCALE=1
# Cross examination questions per side (0 to 2). Default 1.
HJ_CROSS_QUESTIONS=1
# true: seeds the group "The Kitchen" (dave, maya) with two past cases for the leaderboard and judge memory.
HJ_SEED_DEMO=false

# Persistent backend (Supabase Postgres). Default is in memory.
# HJ_STORE=postgres switches the engine to the hj_ tables from supabase/migrations/0005_engine_store.sql.
# Supabase: Project Settings, Database, Connection string. Use the Session pooler string for a long running server.
HJ_STORE=
DATABASE_URL=

# Optional Supabase Auth (Google and guest sign in). Leave off for the handle-only flow.
# To turn on: set both to supabase, then in the Supabase dashboard enable Authentication > Providers > Anonymous
# (and Google, with its client id and secret, plus add your site URL under Authentication > URL Configuration).
HJ_AUTH=
NEXT_PUBLIC_HJ_AUTH=

# Optional live video for the two arguers (LiveKit Cloud, free tier is enough). Leave off for no video.
# Create a project at livekit.io, then copy its URL (wss://...), API key and API secret. Set both flags to livekit.
HJ_VIDEO=
NEXT_PUBLIC_HJ_VIDEO=
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
